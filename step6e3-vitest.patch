+import { describe, expect, it } from "vitest";
+import { buildOpml, parseOpml, MAX_COLUMNS, MIN_COLUMNS } from "./opml";
+import { dashboard, tab, widget } from "@/test/data";
+
+describe("OPML export → import round trip", () => {
+  it("keeps tabs, columns, order, titles and bookmarks", () => {
+    const state = dashboard([
+      tab(
+        "T1",
+        [
+          widget("a", 0, { customTitle: 'Tom & "Jerry" <news>' }),
+          widget("b", 0),
+          widget("c", 2),
+          {
+            id: "f",
+            kind: "bookmarks",
+            url: "",
+            column: 1,
+            customTitle: "Fav",
+            bookmarks: [{ id: "b1", url: "https://a.example/?x=1&y=2", title: "A & B" }],
+          },
+        ],
+        3,
+      ),
+      tab("T2", [widget("d", 1)], 4),
+    ]);
+    const out = parseOpml(buildOpml(state));
+    expect(out.tabs.map((t) => [t.name, t.columns])).toEqual([
+      ["Tab T1", 3],
+      ["Tab T2", 4],
+    ]);
+    expect(out.feedCount).toBe(4); // a, b, c, d (the bookmarks tile is not a feed)
+    expect(out.bookmarkCount).toBe(1);
+    const t1 = out.tabs[0].widgets;
+    expect(t1.find((w) => w.customTitle === 'Tom & "Jerry" <news>')).toBeTruthy();
+    // order inside column 0 is preserved: a then b
+    const col0 = t1.filter((w) => w.column === 0).map((w) => w.url);
+    expect(col0).toEqual(["https://example.com/a.xml", "https://example.com/b.xml"]);
+    const fav = t1.find((w) => w.kind === "bookmarks")!;
+    expect(fav.column).toBe(1);
+    expect(fav.bookmarks![0]).toMatchObject({ url: "https://a.example/?x=1&y=2", title: "A & B" });
+  });
+
+  it("escapes XML special characters in the output", () => {
+    const xml = buildOpml(dashboard([tab("T", [widget("a", 0, { customTitle: "<b>&" })])]));
+    expect(xml).not.toContain('<b>&"');
+    expect(xml).toContain("&lt;b&gt;&amp;");
+  });
+});
+
+describe("parseOpml", () => {
+  it("wraps flat feeds into one 'Imported' tab", () => {
+    const out = parseOpml(`<opml version="2.0"><body>
+      <outline type="rss" text="One" xmlUrl="https://one.example/rss"/>
+      <outline type="rss" text="Two" xmlUrl="https://two.example/rss"/></body></opml>`);
+    expect(out.tabs).toHaveLength(1);
+    expect(out.tabs[0].name).toBe("Imported");
+    expect(out.feedCount).toBe(2);
+  });
+
+  it("reads folders as tabs, ignores empty ones", () => {
+    const out = parseOpml(`<opml version="2.0"><body>
+      <outline text="News"><outline type="rss" xmlUrl="https://n.example/rss"/></outline>
+      <outline text="Empty"></outline></body></opml>`);
+    expect(out.tabs.map((t) => t.name)).toEqual(["News"]);
+  });
+
+  it("reads uStart positions and prefs (single-quoted pseudo-JSON)", () => {
+    const out = parseOpml(`<opml version="2.0"><body><outline text="Home">
+      <outline type="rss" text="Second" xmlUrl="https://b.example/rss" pos="{'col':1,'row':0}" prefs="{&quot;_t&quot;:&quot;My title&quot;}"/>
+      <outline type="rss" text="First" xmlUrl="https://a.example/rss" pos="{'col':0,'row':0}"/>
+      </outline></body></opml>`);
+    const w = out.tabs[0].widgets;
+    expect(w.map((x) => x.url)).toEqual(["https://a.example/rss", "https://b.example/rss"]);
+    expect(w.map((x) => x.column)).toEqual([0, 1]);
+    expect(out.tabs[0].columns).toBe(MIN_COLUMNS);
+    expect(w[1].customTitle).toBe("My title");
+  });
+
+  it("clamps columns to the supported range", () => {
+    const out = parseOpml(`<opml version="2.0"><body><outline text="Wide" lumenColumns="9">
+      <outline type="rss" xmlUrl="https://a.example/rss" pos="{'col':8,'row':0}"/></outline></body></opml>`);
+    expect(out.tabs[0].columns).toBe(MAX_COLUMNS);
+    expect(out.tabs[0].widgets[0].column).toBe(MAX_COLUMNS - 1);
+  });
+
+  it("counts outlines it cannot import", () => {
+    const out = parseOpml(`<opml version="2.0"><body><outline text="Home">
+      <outline type="rss" xmlUrl="https://a.example/rss"/>
+      <outline type="liens" text="Links tile"/></outline></body></opml>`);
+    expect(out.feedCount).toBe(1);
+    expect(out.skipped).toBe(1);
+  });
+
+  it("drops bookmarks with unsafe URLs", () => {
+    const out = parseOpml(`<opml version="2.0"><body><outline text="Home">
+      <outline type="favourites" text="Fav">
+        <outline type="link" text="ok" url="https://ok.example/"/>
+        <outline type="link" text="bad" url="javascript:alert(1)"/></outline></outline></body></opml>`);
+    expect(out.bookmarkCount).toBe(1);
+  });
+
+  it("gives every imported tab and tile its own id", () => {
+    const out = parseOpml(buildOpml(dashboard([tab("T", [widget("a", 0), widget("b", 1)])])));
+    const ids = [out.tabs[0].id, ...out.tabs[0].widgets.map((w) => w.id)];
+    expect(new Set(ids).size).toBe(3);
+  });
+
+  it("rejects files that are not OPML or have no feeds", () => {
+    expect(() => parseOpml("<html/>")).toThrow("Not a valid OPML");
+    expect(() => parseOpml(`<opml version="2.0"><body></body></opml>`)).toThrow();
+    expect(() =>
+      parseOpml(`<opml version="2.0"><body><outline text="Empty"/></body></opml>`),
+    ).toThrow("No RSS feeds");
+  });
+});
diff --git a/src/lib/useAutoRefresh.test.tsx b/src/lib/useAutoRefresh.test.tsx
new file mode 100644
index 0000000..a0f1e26
--- /dev/null
+++ b/src/lib/useAutoRefresh.test.tsx
@@ -0,0 +1,114 @@
+// @vitest-environment jsdom
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { act } from "react";
+import { REFRESH_MS, hashStr, refreshDue, useAutoRefresh } from "./useAutoRefresh";
+import { mount } from "@/test/render";
+
+const due = (o: Partial<Parameters<typeof refreshDue>[0]> = {}) =>
+  refreshDue({
+    hidden: false,
+    fetching: false,
+    now: 1_000_000,
+    lastUpdated: 0,
+    intervalMs: 1000,
+    jitterMs: 0,
+    ...o,
+  });
+
+describe("refreshDue", () => {
+  it("is due once the data is older than interval + jitter", () => {
+    expect(due({ now: 999 })).toBe(false);
+    expect(due({ now: 1000 })).toBe(true);
+    expect(due({ now: 1500, jitterMs: 600 })).toBe(false);
+    expect(due({ now: 1600, jitterMs: 600 })).toBe(true);
+  });
+  it("never refreshes a hidden page or while already fetching", () => {
+    expect(due({ hidden: true })).toBe(false);
+    expect(due({ fetching: true })).toBe(false);
+  });
+});
+
+describe("hashStr", () => {
+  it("is stable and non-negative", () => {
+    expect(hashStr("abc")).toBe(hashStr("abc"));
+    expect(hashStr("widget-1")).toBeGreaterThanOrEqual(0);
+    expect(hashStr("")).toBe(0);
+  });
+  it("spreads different ids", () => {
+    const set = new Set(Array.from({ length: 50 }, (_, i) => hashStr(`w-${i}`) % 120_000));
+    expect(set.size).toBeGreaterThan(40);
+  });
+});
+
+describe("useAutoRefresh", () => {
+  let refetch: ReturnType<typeof vi.fn<() => void>>;
+  let props: { lastUpdated: number; fetching: boolean };
+  const C = () => (
+    useAutoRefresh({ id: "w1", ...props, refetch, intervalMs: 100_000, tickMs: 1000 }),
+    null
+  );
+  const setHidden = (hidden: boolean) =>
+    Object.defineProperty(document, "visibilityState", {
+      value: hidden ? "hidden" : "visible",
+      configurable: true,
+    });
+  const wait = (ms: number) => act(async () => void (await vi.advanceTimersByTimeAsync(ms)));
+
+  beforeEach(() => {
+    vi.useFakeTimers();
+    vi.setSystemTime(1_000_000);
+    refetch = vi.fn();
+    props = { lastUpdated: Date.now(), fetching: false };
+    setHidden(false);
+  });
+  afterEach(() => {
+    vi.useRealTimers();
+    document.body.innerHTML = "";
+  });
+
+  it("default interval is 10 minutes", () => expect(REFRESH_MS).toBe(600_000));
+
+  it("does nothing while the data is fresh", async () => {
+    mount(<C />);
+    await wait(60_000);
+    expect(refetch).not.toHaveBeenCalled();
+  });
+
+  it("refreshes once the data is old enough (within interval + 20% jitter)", async () => {
+    mount(<C />);
+    await wait(99_000);
+    expect(refetch).not.toHaveBeenCalled();
+    await wait(25_000); // 124 s > 100 s + max 20 s of jitter
+    expect(refetch).toHaveBeenCalled();
+  });
+
+  it("pauses while the page is hidden and catches up when it is shown again", async () => {
+    mount(<C />);
+    setHidden(true);
+    await wait(300_000);
+    expect(refetch).not.toHaveBeenCalled();
+    setHidden(false);
+    await act(async () => void document.dispatchEvent(new Event("visibilitychange")));
+    expect(refetch).toHaveBeenCalledTimes(1);
+  });
+
+  it("does not stack requests while one is running", async () => {
+    props.fetching = true;
+    const m = mount(<C />);
+    await wait(300_000);
+    expect(refetch).not.toHaveBeenCalled();
+    props = { lastUpdated: Date.now(), fetching: false };
+    await m.rerender(<C />);
+    await wait(10_000);
+    expect(refetch).not.toHaveBeenCalled(); // fresh again
+  });
+
+  it("stops everything on unmount", async () => {
+    const m = mount(<C />);
+    await m.unmount();
+    await wait(600_000);
+    setHidden(false);
+    document.dispatchEvent(new Event("visibilitychange"));
+    expect(refetch).not.toHaveBeenCalled();
+  });
+});
diff --git a/src/lib/useDashboard.test.tsx b/src/lib/useDashboard.test.tsx
new file mode 100644
index 0000000..4cee006
--- /dev/null
+++ b/src/lib/useDashboard.test.tsx
@@ -0,0 +1,283 @@
+// @vitest-environment jsdom
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { act } from "react";
+import { useDashboard } from "./useDashboard";
+import { fs, snap } from "@/test/fakeFirestore";
+import { auth } from "@/test/fakeAuth";
+import { mount } from "@/test/render";
+import type { DashboardState } from "./rss";
+
+vi.mock("firebase/firestore", () => import("@/test/fakeFirestore"));
+vi.mock("./firebase", () => ({ db: {} }));
+vi.mock("./useAuth", () => import("@/test/fakeAuth"));
+
+let d: ReturnType<typeof useDashboard>;
+let statuses: string[];
+const C = () => ((d = useDashboard()), statuses.push(d.sync.status), null);
+
+const stored = (active: string, tabIds = ["T1", "T2"], extra: Record<string, unknown> = {}) => ({
+  schemaVersion: 1,
+  tabs: tabIds.map((id) => ({
+    id,
+    name: id,
+    columns: 3,
+    widgets:
+      id === "T1"
+        ? [
+            { id: "w1", url: "https://a.example/rss", column: 0 },
+            { id: "w2", url: "https://b.example/rss", column: 0 },
+          ]
+        : [],
+  })),
+  activeTabId: active,
+  globalDefaultStyle: "full",
+  highlightNew: true,
+  ...extra,
+});
+const KEY = "lumen:activeTab:u1";
+const dash = () => fs.on("data/dashboard");
+const server = (data: unknown, fromCache = false) =>
+  act(async () => dash().cb(snap(data, fromCache)));
+const wait = (ms: number) => act(async () => void (await vi.advanceTimersByTimeAsync(ms)));
+const open = async () => {
+  mount(<C />);
+  await act(async () => {});
+};
+const dashWrites = () => fs.sets.filter((s) => s.ref.endsWith("data/dashboard"));
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  fs.reset();
+  localStorage.clear();
+  statuses = [];
+  auth.user = { uid: "u1" };
+});
+afterEach(() => {
+  vi.useRealTimers();
+  document.body.innerHTML = "";
+});
+
+describe("loading and safety", () => {
+  it("shows a starter dashboard in memory only: nothing is written on load", async () => {
+    await open();
+    await server(null); // the server says: no dashboard yet
+    expect(d.state.tabs[0].widgets.length).toBeGreaterThan(0);
+    await wait(5000);
+    expect(dashWrites()).toHaveLength(0);
+  });
+
+  it("ignores edits until the server has answered (offline / cache only)", async () => {
+    await open();
+    await server(null, true);
+    const before = d.state.tabs[0].name;
+    await act(async () => d.renameTab(d.state.tabs[0].id, "Hacked"));
+    await wait(5000);
+    expect(d.state.tabs[0].name).toBe(before); // the edit is refused, not shown and lost
+    expect(dashWrites()).toHaveLength(0);
+    expect(d.sync.status).toBe("offline");
+  });
+
+  it("does not overwrite a stored dashboard it cannot read", async () => {
+    await open();
+    await server({ tabs: "garbage" });
+    expect(d.sync).toMatchObject({ status: "error", issue: "unreadable" });
+    const tabs = d.state.tabs.length;
+    await act(async () => d.addTab("X"));
+    await wait(5000);
+    expect(d.state.tabs).toHaveLength(tabs);
+    expect(dashWrites()).toHaveLength(0);
+  });
+
+  it("guest: empty local dashboard, nothing saved, no subscription", async () => {
+    auth.user = null;
+    await open();
+    expect(d.sync.status).toBe("guest");
+    expect(d.isGuest).toBe(true);
+    await act(async () => d.addTab("Local"));
+    await wait(5000);
+    expect(fs.sets).toHaveLength(0);
+    expect(fs.listeners).toHaveLength(0);
+  });
+
+  it("takes a daily backup of the dashboard found at the first confirmed read", async () => {
+    await open();
+    await server(stored("T1"));
+    await act(async () => {});
+    expect([...fs.store.keys()].some((k) => k.startsWith("users/u1/backups/"))).toBe(true);
+  });
+});
+
+describe("switching tab never touches the database", () => {
+  it("the tab remembered on this device wins over the saved one, with no write", async () => {
+    localStorage.setItem(KEY, "T2");
+    await open();
+    await server(stored("T1"));
+    expect(d.state.activeTabId).toBe("T2");
+    expect(dashWrites()).toHaveLength(0);
+  });
+
+  it("switching: updates the view and the local memory, writes nothing, never shows 'saving'", async () => {
+    await open();
+    await server(stored("T1"));
+    const mark = statuses.length;
+    await act(async () => d.setActiveTab("T2"));
+    await wait(1000);
+    expect(d.state.activeTabId).toBe("T2");
+    expect(localStorage.getItem(KEY)).toBe("T2");
+    expect(dashWrites()).toHaveLength(0);
+    expect(statuses.slice(mark)).not.toContain("saving");
+  });
+
+  it("an unknown tab id is ignored", async () => {
+    await open();
+    await server(stored("T1"));
+    await act(async () => d.setActiveTab("nope"));
+    expect(d.state.activeTabId).toBe("T1");
+  });
+
+  it("a later server snapshot does not throw us back to the saved tab", async () => {
+    await open();
+    await server(stored("T1"));
+    await act(async () => d.setActiveTab("T2"));
+    await server(stored("T1"));
+    expect(d.state.activeTabId).toBe("T2");
+  });
+
+  it("falls back to the saved tab if the open one was deleted elsewhere", async () => {
+    await open();
+    await server(stored("T1"));
+    await act(async () => d.setActiveTab("T2"));
+    await server(stored("T1", ["T1", "T3"]));
+    expect(d.state.activeTabId).toBe("T1");
+  });
+
+  it("a real edit still saves, carrying the tab that is open", async () => {
+    await open();
+    await server(stored("T1"));
+    await act(async () => d.setActiveTab("T2"));
+    await act(async () => d.renameTab("T1", "Renamed"));
+    await wait(700);
+    expect(dashWrites()).toHaveLength(1);
+    expect(dashWrites()[0].data.tabs[0].name).toBe("Renamed");
+    expect(dashWrites()[0].data.activeTabId).toBe("T2");
+  });
+
+  it("adding a tab switches to it, remembers it and saves once", async () => {
+    await open();
+    await server(stored("T1"));
+    await act(async () => d.addTab("New"));
+    const id = d.state.activeTabId;
+    await wait(700);
+    expect(id).not.toBe("T1");
+    expect(localStorage.getItem(KEY)).toBe(id);
+    expect(dashWrites()).toHaveLength(1);
+  });
+
+  it("removing the open tab moves to another one (but never removes the last tab)", async () => {
+    await open();
+    await server(stored("T1"));
+    await act(async () => d.removeTab("T1"));
+    expect(d.state.tabs.map((t) => t.id)).toEqual(["T2"]);
+    expect(d.state.activeTabId).toBe("T2");
+    expect(localStorage.getItem(KEY)).toBe("T2");
+    await act(async () => d.removeTab("T2"));
+    expect(d.state.tabs).toHaveLength(1);
+  });
+});
+
+describe("edits", () => {
+  const widgets = () => d.state.tabs.find((t) => t.id === d.state.activeTabId)!.widgets;
+  const loaded = async () => {
+    await open();
+    await server(stored("T1"));
+  };
+
+  it("several quick edits are saved as ONE write", async () => {
+    await loaded();
+    await act(async () => d.addWidget("https://c.example/rss"));
+    await act(async () => d.updateWidget("w1", { customTitle: "Mine" }));
+    await act(async () => d.setHighlightNew(false));
+    await wait(700);
+    expect(dashWrites()).toHaveLength(1);
+    expect(dashWrites()[0].data.highlightNew).toBe(false);
+  });
+
+  it("a new feed goes to the shortest column", async () => {
+    await loaded(); // column 0 has two tiles, 1 and 2 are empty
+    await act(async () => d.addWidget("https://c.example/rss"));
+    expect(widgets().find((w) => w.url === "https://c.example/rss")!.column).toBe(1);
+  });
+
+  it("removes and updates tiles", async () => {
+    await loaded();
+    await act(async () => d.removeWidget("w1"));
+    expect(widgets().map((w) => w.id)).toEqual(["w2"]);
+    await act(async () => d.updateWidget("w2", { style: "mini" }));
+    expect(widgets()[0].style).toBe("mini");
+  });
+
+  it("drag & drop: moving a tile saves; dropping it where it was does NOT save", async () => {
+    await loaded();
+    await act(async () => d.reorderWidgets("w1", 0, 0)); // already first in column 0
+    await wait(700);
+    expect(dashWrites()).toHaveLength(0);
+    await act(async () => d.reorderWidgets("w1", 2, 0));
+    await wait(700);
+    expect(widgets().find((w) => w.id === "w1")!.column).toBe(2);
+    expect(dashWrites()).toHaveLength(1);
+  });
+
+  it("changing the number of columns keeps every tile; same number = no save", async () => {
+    await loaded();
+    await act(async () => d.setColumns(3));
+    await wait(700);
+    expect(dashWrites()).toHaveLength(0);
+    await act(async () => d.setColumns(4));
+    await act(async () => d.reorderWidgets("w2", 3, 0));
+    await act(async () => d.setColumns(2));
+    expect(d.state.tabs[0].columns).toBe(2);
+    expect(
+      widgets()
+        .map((w) => w.id)
+        .sort(),
+    ).toEqual(["w1", "w2"]);
+    expect(widgets().every((w) => w.column < 2)).toBe(true);
+  });
+
+  it("importing tabs adds them and switches to the first imported", async () => {
+    await loaded();
+    await act(async () => d.importTabs([{ id: "I1", name: "Imp", columns: 3, widgets: [] }]));
+    expect(d.state.tabs.map((t) => t.id)).toEqual(["T1", "T2", "I1"]);
+    expect(d.state.activeTabId).toBe("I1");
+    await act(async () => d.importTabs([]));
+    expect(d.state.tabs).toHaveLength(3);
+  });
+
+  it("restoring a backup replaces everything and is saved (also over unreadable data)", async () => {
+    await open();
+    await server({ tabs: "garbage" });
+    const restored: DashboardState = {
+      tabs: [{ id: "R", name: "R", columns: 2, widgets: [] }],
+      activeTabId: "R",
+      globalDefaultStyle: "full",
+      highlightNew: true,
+    };
+    await act(async () => d.replaceState(restored));
+    await wait(700);
+    expect(d.state.tabs.map((t) => t.id)).toEqual(["R"]);
+    expect(dashWrites()).toHaveLength(1);
+    expect(localStorage.getItem(KEY)).toBe("R");
+  });
+
+  it("styles resolve tile → tab → global", async () => {
+    await loaded();
+    const w = widgets()[0];
+    expect(d.resolveStyle(w)).toBe("full");
+    await act(async () => d.setGlobalStyle("compact"));
+    expect(d.resolveStyle(widgets()[0])).toBe("compact");
+    await act(async () => d.setTabStyle("mini"));
+    expect(d.resolveStyle(widgets()[0])).toBe("mini");
+    await act(async () => d.updateWidget("w1", { style: "condensed" }));
+    expect(d.resolveStyle(widgets()[0])).toBe("condensed");
+  });
+});
diff --git a/src/lib/useSeenItems.test.tsx b/src/lib/useSeenItems.test.tsx
