+export const dashboard = (
+  tabs: DashboardTab[],
+  activeTabId = tabs[0]?.id ?? "",
+): DashboardState => ({
+  tabs,
+  activeTabId,
+  globalDefaultStyle: "full",
+  highlightNew: true,
+});
