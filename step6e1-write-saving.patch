diff --git a/src/lib/linkId.ts b/src/lib/linkId.ts
new file mode 100644
index 0000000..675a687
--- /dev/null
+++ b/src/lib/linkId.ts
@@ -0,0 +1,31 @@
+// Compact, stable identifier for a link (about 11 characters instead of ~100).
+// Used for the "visited" list so the stored document stays far below Firestore's
+// 1 MiB limit and each save moves less data. It is a 53-bit hash: a collision
+// would only mean one article is shown as "visited" by mistake, and the chance is
+// negligible for a few thousand links.
+
+function cyrb53(str: string): number {
+  let h1 = 0xdeadbeef;
+  let h2 = 0x41c6ce57;
+  for (let i = 0; i < str.length; i++) {
+    const ch = str.charCodeAt(i);
+    h1 = Math.imul(h1 ^ ch, 2654435761);
+    h2 = Math.imul(h2 ^ ch, 1597334677);
+  }
+  h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507) ^ Math.imul(h2 ^ (h2 >>> 13), 3266489909);
+  h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507) ^ Math.imul(h1 ^ (h1 >>> 13), 3266489909);
+  return 4294967296 * (2097151 & h2) + (h1 >>> 0);
+}
+
+/** Identifier of a link: lowercase letters and digits only (never contains ":" or "/"). */
+export function linkId(link: string): string {
+  return cyrb53(link).toString(36);
+}
+
+/**
+ * Accepts what is stored in the database: a compact id as is, or an older full
+ * address (which contains ":" and "/") converted to its id.
+ */
+export function toLinkId(stored: string): string {
+  return /[:/]/.test(stored) ? linkId(stored) : stored;
+}
diff --git a/src/lib/useAutoRefresh.ts b/src/lib/useAutoRefresh.ts
new file mode 100644
index 0000000..6fc383d
--- /dev/null
+++ b/src/lib/useAutoRefresh.ts
@@ -0,0 +1,65 @@
+import { useEffect, useRef } from "react";
+
+export const REFRESH_MS = 10 * 60 * 1000;
+
+export function hashStr(s: string): number {
+  let h = 0;
+  for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0;
+  return Math.abs(h);
+}
+
+/**
+ * Should a feed be refreshed now? Never while the page is hidden (background tab)
+ * or while a fetch is already running; otherwise once the data is older than the
+ * interval plus a per-feed jitter (so feeds do not all refresh at the same moment).
+ */
+export function refreshDue(o: {
+  hidden: boolean;
+  fetching: boolean;
+  now: number;
+  lastUpdated: number;
+  intervalMs: number;
+  jitterMs: number;
+}): boolean {
+  if (o.hidden || o.fetching) return false;
+  return o.now - o.lastUpdated >= o.intervalMs + o.jitterMs;
+}
+
+/** Periodic refresh that pauses while the page is hidden and catches up when it is shown again. */
+export function useAutoRefresh(opts: {
+  id: string;
+  lastUpdated: number;
+  fetching: boolean;
+  refetch: () => unknown;
+  intervalMs?: number;
+  tickMs?: number;
+}) {
+  const { id, intervalMs = REFRESH_MS, tickMs = 30_000 } = opts;
+  const latest = useRef(opts);
+  latest.current = opts;
+
+  useEffect(() => {
+    const jitterMs = hashStr(id) % Math.max(1, Math.floor(intervalMs / 5));
+    const check = () => {
+      const cur = latest.current;
+      if (
+        refreshDue({
+          hidden: document.visibilityState === "hidden",
+          fetching: cur.fetching,
+          now: Date.now(),
+          lastUpdated: cur.lastUpdated,
+          intervalMs,
+          jitterMs,
+        })
+      ) {
+        cur.refetch();
+      }
+    };
+    const timer = setInterval(check, tickMs);
+    document.addEventListener("visibilitychange", check);
+    return () => {
+      clearInterval(timer);
+      document.removeEventListener("visibilitychange", check);
+    };
+  }, [id, intervalMs, tickMs]);
+}
