diff --git a/src/lib/exportReminder.ts b/src/lib/exportReminder.ts
new file mode 100644
index 0000000..2477b89
--- /dev/null
+++ b/src/lib/exportReminder.ts
@@ -0,0 +1,69 @@
+// Monthly reminder to download a full JSON backup.
+//
+// "Last export" is stored per user in Firestore (users/{uid}/data/meta), so it is
+// the same on every device and never mixes up accounts. It is recorded only when a
+// full JSON backup is actually downloaded from Lumen (the OPML export and the
+// automatic safety copy made before a restore do not count).
+//
+// "Remind me later" is a per-device convenience kept in localStorage, per user.
+
+export const EXPORT_INTERVAL_DAYS = 30;
+export const SNOOZE_DAYS = 7;
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+export interface ReminderStatus {
+  /** Whole days since the last export; null if none is recorded. */
+  daysSince: number | null;
+  /** True when the reminder should be shown. */
+  due: boolean;
+}
+
+export function reminderStatus(opts: {
+  lastExportAt: Date | null;
+  /** Epoch ms until which the reminder is snoozed on this device. */
+  snoozedUntil: number | null;
+  now?: number;
+}): ReminderStatus {
+  const now = opts.now ?? Date.now();
+  const last = opts.lastExportAt?.getTime() ?? null;
+  const daysSince = last === null ? null : Math.max(0, Math.floor((now - last) / DAY_MS));
+
+  // A date in the future (wrong clock on some device) counts as "just exported".
+  const overdue = last === null || now - last >= EXPORT_INTERVAL_DAYS * DAY_MS;
+  const snoozed = opts.snoozedUntil !== null && now < opts.snoozedUntil;
+  return { daysSince, due: overdue && !snoozed };
+}
+
+/** Parses the stored value; anything that is not a valid date means "never". */
+export function parseExportDate(value: unknown): Date | null {
+  if (typeof value !== "string") return null;
+  const d = new Date(value);
+  return Number.isNaN(d.getTime()) ? null : d;
+}
+
+export function snoozeUntil(now = Date.now()): number {
+  return now + SNOOZE_DAYS * DAY_MS;
+}
+
+// ── Per-device snooze storage ────────────────────────────────────────────────
+
+const snoozeKey = (uid: string) => `lumen:exportReminderSnooze:${uid}`;
+
+export function readSnooze(uid: string): number | null {
+  try {
+    const raw = window.localStorage.getItem(snoozeKey(uid));
+    const n = raw === null ? NaN : Number(raw);
+    return Number.isFinite(n) ? n : null;
+  } catch {
+    return null; // storage blocked or unavailable: the reminder just won't be snoozable
+  }
+}
+
+export function writeSnooze(uid: string, until: number) {
+  try {
+    window.localStorage.setItem(snoozeKey(uid), String(until));
+  } catch {
+    /* ignore */
+  }
+}
diff --git a/src/lib/useExportReminder.ts b/src/lib/useExportReminder.ts
new file mode 100644
index 0000000..23207cc
--- /dev/null
+++ b/src/lib/useExportReminder.ts
@@ -0,0 +1,93 @@
+import { useCallback, useEffect, useMemo, useState } from "react";
+import { doc, onSnapshot, setDoc } from "firebase/firestore";
+import { db } from "./firebase";
+import { useAuth } from "./useAuth";
+import {
+  parseExportDate,
+  readSnooze,
+  reminderStatus,
+  snoozeUntil,
+  writeSnooze,
+} from "./exportReminder";
+
+export interface ExportReminder {
+  /** False for guests: there is no account to attach a backup date to. */
+  enabled: boolean;
+  /** The server has told us what is stored (until then nothing is shown). */
+  loaded: boolean;
+  lastExportAt: Date | null;
+  daysSince: number | null;
+  due: boolean;
+  /** Call right after a full JSON backup has been downloaded. */
+  markExported: () => void;
+  /** Hide the reminder on this device for a few days. */
+  snooze: () => void;
+}
+
+export function useExportReminder(): ExportReminder {
+  const { user } = useAuth();
+  const uid = user?.uid ?? null;
+
+  const [loaded, setLoaded] = useState(false);
+  const [lastExportAt, setLastExportAt] = useState<Date | null>(null);
+  const [snoozedUntil, setSnoozedUntil] = useState<number | null>(null);
+
+  useEffect(() => {
+    setLoaded(false);
+    setLastExportAt(null);
+    if (!uid) {
+      setSnoozedUntil(null);
+      return;
+    }
+    setSnoozedUntil(readSnooze(uid));
+
+    const ref = doc(db, "users", uid, "data", "meta");
+    return onSnapshot(
+      ref,
+      // Also report when the cache answer is later confirmed by the server.
+      { includeMetadataChanges: true },
+      (snap) => {
+        // "No document" from an empty local cache proves nothing (offline / slow):
+        // wait for the server, otherwise we would nag someone who did export.
+        if (snap.metadata.fromCache && !snap.exists()) return;
+        setLastExportAt(parseExportDate(snap.data()?.lastJsonExportAt));
+        setLoaded(true);
+      },
+      (e) => console.error("Backup reminder subscription error:", e),
+    );
+  }, [uid]);
+
+  const markExported = useCallback(() => {
+    if (!uid) return;
+    const now = new Date();
+    setLastExportAt(now);
+    // merge: this document may hold other fields in the future.
+    setDoc(
+      doc(db, "users", uid, "data", "meta"),
+      { lastJsonExportAt: now.toISOString() },
+      { merge: true },
+    ).catch((e) => console.error("Could not record the backup date:", e));
+  }, [uid]);
+
+  const snooze = useCallback(() => {
+    if (!uid) return;
+    const until = snoozeUntil();
+    writeSnooze(uid, until);
+    setSnoozedUntil(until);
+  }, [uid]);
+
+  const { daysSince, due } = useMemo(
+    () => reminderStatus({ lastExportAt, snoozedUntil }),
+    [lastExportAt, snoozedUntil],
+  );
+
+  return {
+    enabled: !!uid,
+    loaded,
+    lastExportAt,
+    daysSince,
+    due: !!uid && loaded && due,
+    markExported,
+    snooze,
+  };
+}
